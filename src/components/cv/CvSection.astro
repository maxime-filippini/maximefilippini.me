---
interface Props {
  title: string;
}
---

<section class="border-b border-base-300">
  <div class="max-w-4xl mx-auto px-6 py-8 sm:px-8 sm:py-10">
    <h2 class="text-2xl sm:text-3xl font-semibold mb-4">{Astro.props.title}</h2>
    <div class="divide-y divide-base-300">
      <slot />
    </div>
  </div>
</section>
