---
// One row of the CV: a date column, then a title, subtitle and description.
interface Props {
  when: string;
  title: string;
  subtitle: string;
}
const { when, title, subtitle } = Astro.props;
---

<article class="grid sm:grid-cols-[10rem_1fr] gap-3 sm:gap-8 py-6">
  <p class="text-sm text-base-content/60">{when}</p>
  <div>
    <p class="text-lg sm:text-xl font-semibold">{title}</p>
    <p class="text-sm font-semibold text-base-content/70 mb-4">{subtitle}</p>
    <div class="text-sm sm:text-base text-base-content/70 leading-relaxed [&_ul]:list-disc [&_ul]:list-inside">
      <slot />
    </div>
  </div>
</article>
