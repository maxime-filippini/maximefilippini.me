{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maximefilippini-me",
  "compatibility_date": "2026-10-21",
  // Static site only: no Worker script, Cloudflare serves the built files.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "workers_dev": true,
  "preview_urls": true,
  // Required by `wrangler preview`, which Workers Builds runs for every branch
  // other than main. Empty means previews use the same settings as above.
  "previews": {},

  "routes": [{ "pattern": "maximefilippini.me", "custom_domain": true }],
}
